#toast .alert { font-size: 1.1rem; }

#toast .alert i { vertical-align: middle; font-size: 1.2rem; }

img:not([src]) { opacity: 0; }

.dot + .dot::before { content: ""; background: var(--bs-text-muted); vertical-align: middle; border-radius: 50%; width: 0.1rem; height: 0.1rem; margin-left: 0.3rem; margin-right: 0.45rem; display: inline-block; }

.loading { justify-content: center; align-items: center; width: 100%; height: 100%; display: flex; }

.loading::before { content: ""; background-image: linear-gradient(var(--bs-secondary)1rem,transparent 0),linear-gradient(var(--bs-secondary)1rem,transparent 0),linear-gradient(var(--bs-secondary)1rem,transparent 0); background-position: 0px 0px, 1.3rem 0px, 2.6rem 0px; background-repeat: no-repeat; background-size: 1rem; width: 4rem; height: 1rem; margin: 1rem auto; animation: 0.7s linear 0s infinite normal none running pgfill; display: block; }

